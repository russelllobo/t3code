# Copy to .env to build the design fork locally.
#
# This fork installs alongside official T3 Code. Widgets, the iOS share
# extension, push notifications, and Sign in with Apple are omitted to keep
# the build fast and signing simple. Local/LAN pairing still works.
T3CODE_DESIGN_FORK=1
T3CODE_DESIGN_APP_NAME=T3 Code Design
T3CODE_DESIGN_BUNDLE_ID=com.russellsystems.t3design
T3CODE_DESIGN_APPLE_TEAM_ID=SZ78KGUF6B
T3CODE_MOBILE_UPDATES_ENABLED=0
T3CODE_MOBILE_VERSION=1.0.0
